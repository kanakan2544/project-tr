# --- Database (Phase 9) ---
# Matches docker-compose.yml postgres service.
DATABASE_URL="postgresql://tcg:tcg@localhost:5432/tcg?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# Shared between apps/web (issues the JWT) and apps/server (verifies it).
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Client → server websocket ---
NEXT_PUBLIC_SERVER_URL="ws://localhost:2567"
