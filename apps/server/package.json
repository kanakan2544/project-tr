{
  "name": "@tcg/server",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "prisma generate --schema=../../packages/db/prisma/schema.prisma && node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tcg/card-data": "workspace:*",
    "@tcg/db": "workspace:*",
    "@tcg/game-engine": "workspace:*",
    "@tcg/shared-types": "workspace:*",
    "colyseus": "^0.15.0",
    "@colyseus/monitor": "^0.15.0",
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "jose": "^5.9.6",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "esbuild": "^0.24.0",
    "prisma": "^5.22.0",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2"
  }
}
